# Airtable — Tester Classes page (optional; seed data is used when unset)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_CLASSES_TABLE=Classes

# Sanity — Timetable (optional; seed data is used when unset). Studio: /studio
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# SEO indexing. Search engines may index only the real production site.
# Vercel production deployments are indexable automatically; local, preview and other hosts are noindex.
# On any other host set SEO_INDEXING=enabled only when that host is the live site.
# SEO_INDEXING=enabled

# ---- Contact form (names only; never commit real values) ----
# Where contact enquiries are delivered. Outside production it defaults to the test inbox.
# In production it MUST be set.
CONTACT_RECIPIENT_EMAIL=
# Outgoing mail (Resend). MAIL_FROM must be an address the provider allows for your account
# (a verified domain, or the provider's own test sender while no domain is verified).
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=
# Spam protection (Cloudflare Turnstile). In production BOTH keys are required: without them the
# form refuses to send. NEXT_PUBLIC_ is read at build time, so set it before the build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shared rate limiting (optional; otherwise each server instance counts on its own).
# Run supabase/migrations/0000_rate_limit.sql first. Server only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random text used to scramble network addresses in rate-limit keys.
RATE_LIMIT_SALT=
