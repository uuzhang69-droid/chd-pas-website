# Airtable — Tester Classes page (optional; seed data is used when unset)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_CLASSES_TABLE=Classes

# Sanity — Timetable (optional; seed data is used when unset). Studio: /studio
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# SEO indexing. Search engines may index only the real production site.
# Vercel production deployments are indexable automatically; local, preview and other hosts are noindex.
# On any other host set SEO_INDEXING=enabled only when that host is the live site.
# SEO_INDEXING=enabled

# ---- Contact form and newsletter (names only; never commit real values) ----
# Three different addresses, three different jobs. They do not have to be the same, and none replaces another:
#   MAIL_FROM                 the address every outgoing message comes FROM (contact notifications, newsletter
#                             confirmation and welcome emails). Format: Name <address@domain>, no quotes. The provider must
#                             allow it: a domain verified in Resend, or onboarding@resend.dev (which delivers only to the
#                             Resend account owner's own address) while no domain is verified.
#   CONTACT_RECIPIENT_EMAIL   the inbox that RECEIVES messages sent through the contact form. Outside production it defaults
#                             to the test inbox; in production it MUST be set.
#   NEWSLETTER_ADMIN_EMAILS   the people allowed to sign in to /admin to see, export and manage subscribers (comma separated).
#                             Each must also exist in Supabase Auth with a confirmed email. Nothing is ever sent to these
#                             addresses because of this setting; it is a sign-in allow-list only.
CONTACT_RECIPIENT_EMAIL=
# Outgoing mail (Resend).
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=
# Spam protection (Cloudflare Turnstile). When the secret is set the check is enforced.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Newsletter database (a separate Supabase project). Server only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Administrator sign-in through Supabase Auth (server only).
SUPABASE_ANON_KEY=
# Sign-in allow-list for /admin (see the three-address note above).
NEWSLETTER_ADMIN_EMAILS=
# Public newsletter sign-up. Open ONLY when this is exactly the word true; unset, empty or anything else keeps it closed.
# Leave it unset until sign-up is approved. It is read on the server and the footer form is decided when the site is built,
# so change it before a build and redeploy. When it is true, ALL of these must be set: NEWSLETTER_TOKEN_SECRET,
# APP_BASE_URL, the Supabase values, mail settings and both Turnstile keys; and the Privacy Policy must be published.
# NEWSLETTER_ONLINE_SIGNUP_LIVE=true
# What happens to a sign-up once the form is open (server-side; this does NOT open the form):
#   collect_only   (the default, also used when this is unset or misspelt)
#                  the request is stored in Supabase as an UNVERIFIED "pending" record with its consent version, time and source.
#                  NO email is sent: no confirmation, no welcome, nothing is sent to Resend. Nobody becomes "active".
#                  Needs only SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, the Turnstile keys and RATE_LIMIT_SALT.
#   double_opt_in  the confirmation-email workflow: a confirmation email, a confirm link, then "active" and a welcome email.
#                  Also needs MAIL_API_KEY, MAIL_FROM, NEWSLETTER_TOKEN_SECRET and APP_BASE_URL.
# NEWSLETTER_DELIVERY_MODE=collect_only
# REQUIRED when sign-up is on: at least 32 random characters. Signs confirm and unsubscribe links; changing it breaks
# links already sent.
NEWSLETTER_TOKEN_SECRET=
# Random text used to scramble network addresses in rate-limit keys.
RATE_LIMIT_SALT=
# REQUIRED when sign-up is on: the public https address of the live site (for example https://www.example.com), used in
# emailed confirmation and unsubscribe links. In production there is no fallback, because the request's Host header must
# never decide where a confirmation link points.
APP_BASE_URL=
